# Local RAG Studio configuration. Copy to .env (in this folder) and fill in.
# The backend reads ONLY this .env file; real environment variables override it.

# --- LLM: any OpenAI-compatible endpoint ---------------------------------------
# Option A: OpenRouter (hosted; documents' retrieved chunks are sent to the provider)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_API_KEY=...   (also accepted when LLM_API_KEY is not set)

# Option B: Ollama (fully local; nothing leaves your machine)
#   1. Install Ollama, then:  ollama pull llama3.2
#   2. Replace the three lines above with:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama            (any non-empty value; Ollama ignores it)
# LLM_MODEL=llama3.2

# --- Embeddings (always local) --------------------------------------------------
# Changing this marks every collection stale; re-index them afterwards.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Admin (written by: cd backend; python -m app.scripts.set_admin_password) ---
# ADMIN_PASSWORD_HASH=...
# JWT_SECRET=...

# --- Server -----------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=data
